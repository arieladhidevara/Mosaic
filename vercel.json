{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ai/edit",
      "destination": "/api/ai/generate?_mozai_mode=edit"
    },
    {
      "source": "/api/ai/edit-context",
      "destination": "/api/ai/generate?_mozai_mode=edit-context"
    },
    {
      "source": "/api/ai/harmonize",
      "destination": "/api/ai/generate?_mozai_mode=harmonize"
    },
    {
      "source": "/api/ai/master",
      "destination": "/api/ai/generate?_mozai_mode=master"
    },
    {
      "source": "/api/ai/chat",
      "destination": "/api/ai/generate?_mozai_mode=chat"
    },
    {
      "source": "/api/ai/benchmark-object-map",
      "destination": "/api/ai/generate?_mozai_mode=benchmark-object-map"
    }
  ]
}
