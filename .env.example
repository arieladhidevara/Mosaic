# Local auto-login is OFF unless explicitly enabled. Never set it in Vercel.
MOSAIC_DEV_AUTH=false

# Required for real application login. Server-only; never commit real values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.

# Optional exact origin for CSRF checks. Set separately for each deployment.
# MOSAIC_APP_ORIGIN=https://your-mosaic-domain.vercel.app

# No OpenAI key belongs in an environment file. Enter BYOK in the editor;
# it stays client-side, with optional encrypted remembering in this browser.
# It is never saved in a server database or project file.
