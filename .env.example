# Local auto-login is OFF unless explicitly enabled. Never set it in Vercel.
MOSAIC_DEV_AUTH=false

# Required for real application login. Server-only; never commit real values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.

# Optional exact origin for CSRF checks. Set separately for each deployment.
# MOSAIC_APP_ORIGIN=https://your-mosaic-domain.vercel.app

# Optional server-side authentication for the SAM 3 Space.
# Anonymous calls have a small shared ZeroGPU quota. Never put this token in frontend code.
MOZAI_HF_SAM3_SPACE_URL=https://arieladhidevara-mozai.hf.space
HF_SAM3_TOKEN=

# No OpenAI key belongs in an environment file. Enter BYOK in the editor;
# it is encrypted on the server in the signed-in account profile.
# It is never returned to the browser or stored in a project file.

# AI Assistant only: use a Gemini API key from a Google AI Studio Free-tier project.
# Keep billing disabled for that project to enforce the free quota. No paid fallback.
# Server-only; put the real value in .env.local or deployment Secret settings.
GEMINI_API_KEY=
